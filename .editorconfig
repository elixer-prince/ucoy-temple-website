; EditorConfig for the Ucoy Temple website.
; Keeps every editor on the same whitespace rules so Prettier
; only has to care about the opinions that matter.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{svg,woff2,png,jpeg}]
insert_final_newline = false
trim_trailing_whitespace = false