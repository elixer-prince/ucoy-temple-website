    "eslint-plugin-astro": "^3.2.1",
    "globals": "^16.3.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.4.3",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "keywords": [],
