# Prettier reads .gitignore by default, so anything the build generates is
# already skipped. This file covers what .gitignore cannot: files that live
# inside the repository on purpose but must not be reformatted.

# Vendored agent skills, installed and pinned by skills-lock.json.
# Reformatting them would fight the pinned versions and slow every check.
.agents/

# Agent and editor config directories, owned by their own tools.
.continue/
.windsurf/

# Husky's generated hook shims. The hand written .husky/pre-commit stays in
# scope, only the generated _ folder is skipped.
.husky/_/

# Scratch files, so an in progress check never parses a half written file.
.tmp-*

# Build output and generated types, repeated from .gitignore so this list does
# not depend on those two files staying in step.
dist/
.astro/
node_modules/

# Generated by npm on every install, never hand edited.
package-lock.json

# No TOML parser is installed, so an explicit run on this file errors out.
wrangler.toml
