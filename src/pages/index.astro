---
import { getCollection } from 'astro:content'
import { SITE_CONFIG } from '@/config/site'
import { fetchCalendarEvents, type CalendarEvent, type CalendarWindow } from '@/lib/calendar-events'
import Layout from '@layouts/Layout.astro'
import Panel from '@components/Panel.astro'
import Callout from '@components/Callout.astro'

/**
 * Format a Date for human-readable display (English, no external deps).
 * Replaces the placeholder Hebrew date computation that will be wired
 * in during the content-model feature.
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}

// Fetch non-draft announcements, newest first.
const announcements = await getCollection('announcements', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)
const recentAnnouncements = announcements
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

// Weekly services, for the service times list. Read from the same collection
// the service pages are built from, so the home page and the pages themselves
// can never disagree about a day or a time (scope feature 5).
const weeklyServices = (await getCollection('services', ({ data }) => data.kind === 'weekly')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
)

/**
 * Format one upcoming event's date and time for the list.
 *
 * An all day event shows just the date, since a time would be invented. A timed
 * event shows the time beside the date, read in the temple's own timezone so a
 * member in Kingston sees the time that matters to them (spec 0007).
 */
function formatEventDate(event: CalendarEvent): string {
  if (event.allDay) {
    return event.start.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      timeZone: SITE_CONFIG.calendarTimezone
    })
  }
  return event.start.toLocaleString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: SITE_CONFIG.calendarTimezone
  })
}

// Upcoming events, read from the temple's Proton Calendar feed at build time
// (spec 0007). This runs once while the site builds and writes plain HTML, so a
// visitor's browser never contacts a third party to see the list, and the page
// works offline once cached. The window looks from the start of today out 90
// days, which is far enough to carry a season of Holy Days without listing a
// year at once. A missing feed, or a feed that cannot be read, never fails the
// build: the page falls back to a quiet notice, exactly like the service list.
let upcomingEvents: CalendarEvent[] = []
let eventsNotice: string | null = null

if (SITE_CONFIG.calendarUrl) {
  const today = new Date()
  today.setHours(0, 0, 0, 0)
  const window: CalendarWindow = { from: today, to: new Date(today.getTime() + 90 * 86_400_000) }
  try {
    upcomingEvents = await fetchCalendarEvents(SITE_CONFIG.calendarUrl, window)
    if (upcomingEvents.length === 0) {
      eventsNotice = 'No upcoming events are listed right now. Please check back soon.'
    }
  } catch {
    eventsNotice = 'The events list could not be loaded. Please check back soon.'
  }
} else {
  eventsNotice = 'Upcoming events will be listed here once the calendar is connected.'
}
---

<Layout title="Home" description={SITE_CONFIG.description}>
  <!-- Hero / welcome -->
  <section class="hero">
    <div class="prose">
      <h1 class="hero-title">{SITE_CONFIG.title}</h1>
      <p class="hero-hebrew" lang="he" dir="rtl">
        עדת ישראה
      </p>
      <p class="hero-subtitle">
        An Orthodox Jewish temple in Jamaica. Our aim is to spread the word of Yahweh with the world
        and make it enjoyable for the masses. We hope to inspire the population to live a more
        upright life and turn from wrongdoing. We gather to worship, study Torah and the Testimony,
        and keep the appointed times — available on your phone even with no internet.
      </p>

      <nav class="hero-nav" aria-label="Quick links">
        <a href="/about" class="button">
          About us
        </a>
        <a href="/visiting" class="button">
          Visit us
        </a>
        <a href="/contact" class="button">
          Contact
        </a>
      </nav>
    </div>
  </section>

  <!-- Where we are, in the temple's own words from its current site (feature 9) -->
  <section class="find-us">
    <div class="prose">
      <h2>Come find us</h2>
      <p>
        The United Congregation of Yisra'Yah (UCOY) is located in the parish of St. Andrew, Jamaica.
        You can find our temple in the humble community of Waterhouse. All are welcomed. Feel free
        to visit us!
      </p>
      <p>
        <a href="/visiting">When we meet and how to find us</a>
      </p>
    </div>
  </section>

  <!-- Service schedule overview, built from the services collection -->
  <section class="service-times">
    <div class="prose">
      <Panel title="Service times" tone="plain">
        {weeklyServices.length > 0 ? (
          <ul class="service-list">
            {weeklyServices.map((service) => (
              <li class="service-row">
                <a class="service-link" href={`/services/${service.id}`}>
                  {service.data.title}
                </a>
                {(service.data.day || service.data.time) && (
                  <span class="service-when text-muted">
                    {[service.data.day, service.data.time].filter(Boolean).join(' · ')}
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted">Service times are being updated. Please check back soon.</p>
        )}

        <p class="text-muted">
          Times shift with the seasons. See the
          <a href="/visiting">visiting page</a> for directions and full details.
        </p>
      </Panel>
    </div>
  </section>

  <!-- Latest announcements (AC-6: newest first) -->
  <section class="announcements">
    <div class="prose">
      <h2>Latest announcements</h2>

      {recentAnnouncements.length > 0 ? (
        recentAnnouncements.map((announcement) => (
          <article class="announcement">
            <h3>{announcement.data.title}</h3>
            <p class="announcement-date text-muted">{formatDate(announcement.data.date)}</p>
            {announcement.data.summary && <p>{announcement.data.summary}</p>}
          </article>
        ))
      ) : (
        <p class="text-muted">No announcements at this time.</p>
      )}
    </div>
  </section>

  <!-- Upcoming events, read from the temple's Proton Calendar feed at build
       time (spec 0007). Plain HTML, no iframe, no third party at view time. -->
  <section class="calendar">
    <div class="prose">
      <h2>Upcoming events</h2>
      <Callout title="Where events come from">
        Events come from the temple's shared calendar. Staff update the calendar and the changes
        appear here the next time the site is published.
      </Callout>

      {upcomingEvents.length > 0 ? (
        <ul class="event-list">
          {upcomingEvents.map((event) => (
            <li class="event-row">
              {event.url ? (
                <a class="event-link" href={event.url}>
                  {event.title}
                </a>
              ) : (
                <span class="event-title">{event.title}</span>
              )}
              <span class="event-when text-muted">
                {[formatEventDate(event), event.location].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted">{eventsNotice}</p>
      )}
    </div>
  </section>

  <section class="holy-days">
    <h2>Holy Days Calendar</h2>
    <p>
      The fixed festival dates for the current Hebrew year are computed from the calendar at each
      build. See the full list and links to each day's service.
    </p>
    <a class="button" href="/holy-days">
      View Holy Days
    </a>
  </section>
</Layout>

<style>
  .holy-days {
    padding: var(--space-xl) 0;
  }

  .holy-days h2 {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    margin: 0 0 var(--space-s) 0;
  }

  .holy-days p {
    margin: 0 0 var(--space-m) 0;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  .button:hover {
    background: var(--color-accent-hover);
  }

  .button:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
  }
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    margin-bottom: var(--space-xs);
  }

  .hero-hebrew {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    color: var(--color-accent);
    margin: 0 0 var(--space-s);
  }

  .hero-subtitle {
    font-size: var(--text-body);
    color: var(--color-text);
    margin-bottom: var(--space-l);
  }

  .hero-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .find-us {
    padding: var(--space-xl) 0;
  }

  .service-times {
    padding: var(--space-xl) 0;
  }

  /* The list is the service times, so it reads as a table of links without
     being one: the title leads, the day and time sit after it in muted text. */
  .service-list {
    list-style: none;
    padding-inline-start: 0;
    margin: 0 0 var(--space-xs) 0;
  }

  .service-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    padding: var(--space-2xs) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .service-row:last-child {
    border-bottom: none;
  }

  .service-when {
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .announcements {
    padding: var(--space-xl) 0;
  }

  .announcement {
    border-bottom: var(--border-width) solid var(--color-border);
    padding: var(--space-s) 0;
  }

  .announcement:last-child {
    border-bottom: none;
  }

  .announcement-date {
    font-size: var(--text-small);
  }

  .calendar {
    padding: var(--space-xl) 0;
  }

  /* The list is the upcoming events, styled like the service list above: the
     title leads, the date, time, and place sit after it in muted text. */
  .event-list {
    list-style: none;
    padding-inline-start: 0;
    margin: var(--space-s) 0 0;
  }

  .event-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    padding: var(--space-2xs) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .event-row:last-child {
    border-bottom: none;
  }

  .event-when {
    font-size: var(--text-small);
  }
</style>
