---
import { getCollection } from 'astro:content'
import { SITE_CONFIG } from '@/config/site'
import Layout from '@layouts/Layout.astro'
import Panel from '@components/Panel.astro'
import Callout from '@components/Callout.astro'

/**
 * Format a Date for human-readable display (English, no external deps).
 * Replaces the placeholder Hebrew date computation that will be wired
 * in during the content-model feature.
 */
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}

// Fetch non-draft announcements, newest first.
const announcements = await getCollection('announcements', ({ data }) =>
  import.meta.env.PROD ? !data.draft : true
)
const recentAnnouncements = announcements
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)

// Weekly services, for the service times list. Read from the same collection
// the service pages are built from, so the home page and the pages themselves
// can never disagree about a day or a time (scope feature 5).
const weeklyServices = (await getCollection('services', ({ data }) => data.kind === 'weekly')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
)

// Build the Google Calendar embed URL (AC-2: agenda view, temple timezone).
const calendarUrl =
  'https://calendar.google.com/calendar/embed?' +
  new URLSearchParams({
    src: SITE_CONFIG.calendarId,
    ctz: SITE_CONFIG.calendarTimezone,
    mode: 'AGENDA',
    showTitle: '0',
    showNav: '0',
    showDate: '0',
    showPrint: '0',
    showTabs: '0',
    showCalendars: '0',
    showTz: '0'
  })
---

<Layout title="Home" description={SITE_CONFIG.description}>
  <!-- Hero / welcome -->
  <section class="hero">
    <div class="prose">
      <h1 class="hero-title">{SITE_CONFIG.title}</h1>
      <p class="hero-hebrew" lang="he" dir="rtl">
        עדת ישראה
      </p>
      <p class="hero-subtitle">
        A Messianic congregation rooted in the Hebrew roots of the faith. We gather to worship,
        study Torah and the Testimony, and keep the appointed times — available on your phone even
        with no internet.
      </p>

      <nav class="hero-nav" aria-label="Quick links">
        <a href="/about" class="button">
          About us
        </a>
        <a href="/visiting" class="button">
          Visit us
        </a>
        <a href="/contact" class="button">
          Contact
        </a>
      </nav>
    </div>
  </section>

  <!-- Service schedule overview, built from the services collection -->
  <section class="service-times">
    <div class="prose">
      <Panel title="Service times" tone="plain">
        {weeklyServices.length > 0 ? (
          <ul class="service-list">
            {weeklyServices.map((service) => (
              <li class="service-row">
                <a class="service-link" href={`/services/${service.id}`}>
                  {service.data.title}
                </a>
                {(service.data.day || service.data.time) && (
                  <span class="service-when text-muted">
                    {[service.data.day, service.data.time].filter(Boolean).join(' · ')}
                  </span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted">Service times are being updated. Please check back soon.</p>
        )}

        <p class="text-muted">
          Times shift with the seasons. See the
          <a href="/visiting">visiting page</a> for directions and full details.
        </p>
      </Panel>
    </div>
  </section>

  <!-- Latest announcements (AC-6: newest first) -->
  <section class="announcements">
    <div class="prose">
      <h2>Latest announcements</h2>

      {recentAnnouncements.length > 0 ? (
        recentAnnouncements.map((announcement) => (
          <article class="announcement">
            <h3>{announcement.data.title}</h3>
            <p class="announcement-date text-muted">{formatDate(announcement.data.date)}</p>
            {announcement.data.summary && <p>{announcement.data.summary}</p>}
          </article>
        ))
      ) : (
        <p class="text-muted">No announcements at this time.</p>
      )}
    </div>
  </section>

  <!-- Upcoming events from Google Calendar (AC-2) -->
  <section class="calendar">
    <div class="prose">
      <h2>Upcoming events</h2>
      <Callout title="Where events come from">
        Events come directly from the temple's Google Calendar — staff update calendar.google.com
        and the changes appear here with the next visit.
      </Callout>

      <iframe
        src={calendarUrl}
        class="calendar-embed"
        style="border: 0"
        width="100%"
        height="650"
        loading="lazy"
        title="Upcoming events from the temple Google Calendar"
      >
        <!-- Iframes do not require JavaScript. -->
        <p>Your browser does not support iframes.</p>
      </iframe>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    margin-bottom: var(--space-xs);
  }

  .hero-hebrew {
    font-family: var(--font-serif);
    font-size: var(--text-title);
    color: var(--color-accent);
    margin: 0 0 var(--space-s);
  }

  .hero-subtitle {
    font-size: var(--text-body);
    color: var(--color-text);
    margin-bottom: var(--space-l);
  }

  .hero-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    justify-content: center;
  }

  .service-times {
    padding: var(--space-xl) 0;
  }

  /* The list is the service times, so it reads as a table of links without
     being one: the title leads, the day and time sit after it in muted text. */
  .service-list {
    list-style: none;
    padding-inline-start: 0;
    margin: 0 0 var(--space-xs) 0;
  }

  .service-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-s);
    padding: var(--space-2xs) 0;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .service-row:last-child {
    border-bottom: none;
  }

  .service-when {
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .announcements {
    padding: var(--space-xl) 0;
  }

  .announcement {
    border-bottom: var(--border-width) solid var(--color-border);
    padding: var(--space-s) 0;
  }

  .announcement:last-child {
    border-bottom: none;
  }

  .announcement-date {
    font-size: var(--text-small);
  }

  .calendar {
    padding: var(--space-xl) 0;
  }

  .calendar-embed {
    border-radius: var(--radius);
    border: var(--border-width) solid var(--color-border);
    margin-top: var(--space-s);
  }
</style>
