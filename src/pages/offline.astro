---
/**
 * Offline fallback page (feature 16).
 *
 * This page is built by Astro so it can import design tokens instead of
 * repeating raw values.  The precache-manifest integration copies the built
 * HTML to dist/offline.html after each build, so the service worker can
 * always find it at a fixed address.
 *
 * It carries noindex so search engines do not index it, and it is unlinked
 * from the menu so no one reaches it while online.
 */
import '@styles/tokens.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>No connection</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('ucoy-theme')
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved)
        }
      } catch {
        /* device setting decides */
      }
    </script>
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-m);
        min-height: 100dvh;
        margin: 0;
        padding: var(--space-m);
        background: var(--color-canvas);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: var(--text-body);
        line-height: var(--body-line-height);
        text-align: center;
      }

      .panel {
        max-width: var(--max-content-width);
        padding: var(--space-l);
        border: var(--border-width) solid var(--color-border);
        border-radius: var(--radius);
        background: var(--color-surface);
      }

      h1 {
        margin: 0 0 var(--space-2xs);
        color: var(--color-text);
        font-family: var(--font-serif);
        font-size: var(--text-title);
        line-height: var(--heading-line-height);
      }

      p {
        margin: 0 0 var(--space-s);
      }

      p:last-of-type {
        margin-bottom: 0;
      }

      .note {
        color: var(--color-text-muted);
        font-size: var(--text-small);
      }

      a.button {
        display: inline-flex;
        align-items: center;
        min-height: var(--touch-target);
        margin-top: var(--space-2xs);
        padding: var(--space-2xs) var(--space-m);
        border-radius: var(--radius);
        background: var(--color-accent);
        color: var(--color-on-accent);
        font-weight: 600;
        text-decoration: none;
      }

      a.button:focus-visible {
        outline: var(--focus-width) solid var(--color-focus);
        outline-offset: var(--focus-offset);
      }
    </style>
  </head>
  <body>
    <main class="panel">
      <h1>There is no connection</h1>
      <p>
        This page has not been saved on your device yet, so it cannot be opened without a
        connection. Pages you have already opened are still available.
      </p>
      <p class="note">Reconnect, then open the page again.</p>
      <a class="button" href="/">
        Go to the home page
      </a>
    </main>
  </body>
</html>
