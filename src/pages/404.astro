---
import Layout from '@layouts/Layout.astro';
import '@styles/tokens.css';
import '@styles/base.css';
---

<Layout title="Page not found" description="The page you are looking for does not exist.">
  <div class="container not-found">
    <h1 style="text-align: center; font-family: var(--font-serif);">Not found</h1>

    <p style="text-align: center; color: var(--muted);">
      The page you are looking for doesn’t exist, or you are offline and it
      hasn’t been saved to your device yet.
    </p>

    <p style="text-align: center;">
      <a href="/" class="button">Go to the home page</a>
    </p>

    <p style="text-align: center; margin-top: var(--space-s);">
      <a href="/offline.html">Go to the offline page</a>
    </p>
  </div>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    padding: var(--space-xl) 0;
  }
</style>
