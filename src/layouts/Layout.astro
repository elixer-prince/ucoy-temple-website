---
/**
 * Layout shell (spec 0004, AC-5).
 * Imports stylesheets once, renders header, sidebar, content, footer.
 */
import { SITE_CONFIG } from '@/config/site'
import { ClientRouter } from 'astro:transitions'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import Sidebar from '@components/Sidebar.astro'
import SkipLink from '@components/SkipLink.astro'
import '@styles/tokens.css'
import '@styles/base.css'
import '@styles/prose.css'

interface Props {
  title: string
  description?: string
  robots?: string
  /** Whether Pagefind should index this page. Defaults to true; the style
   *  guide and 404 set it false so they stay out of the search index. */
  searchable?: boolean
}

const { title, description = SITE_CONFIG.description, robots, searchable = true } = Astro.props
const hasBanner = Astro.slots.has('banner')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {SITE_CONFIG.title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}

    <!-- Canonical link -->
    <link rel="canonical" href={Astro.url.pathname} />

    <!-- Favicon: one PNG for every surface. A 32px context is the tab,
         the touch icon is iOS's home screen, and the header mark is the
         same file drawn small. -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Theme colour follows the canvas role in each mode. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14151b" />
    <meta name="color-scheme" content="light dark" />

    <!-- ClientRouter: instant page swaps with no animation (spec 0008).
         No handleFallback: a fallback of none stops the router registering
         its listeners where View Transitions are missing, leaving
         astro:page-load unfired and the theme switch dead. No prefetch key
         in astro.config.mjs either: pages already sit in the worker cache. -->
    <ClientRouter />

    <!-- Theme choice on device, applied before paint. -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('ucoy-theme')
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved)
        }
      } catch {
        /* storage unavailable: fall through to OS setting */
      }
    </script>
  </head>

  <body>
    <SkipLink transition:animate="none" />
    <Header transition:animate="none" />

    <input
      class="sidebar-toggle"
      type="checkbox"
      id="sidebar-toggle"
      autocomplete="off"
      aria-label="Show menu"
    />

    <div class:list={['shell', { 'shell--with-banner': hasBanner }]}>
      <label class="sidebar-backdrop" for="sidebar-toggle" aria-hidden="true"></label>
      <aside class="sidebar" id="sidebar" transition:animate="none">
        <Sidebar />
        <div class="theme-switch">
          <button class="theme-button" id="theme-button" type="button" hidden>
            Theme: System
          </button>
          <noscript>
            <p class="theme-note">The theme follows your device setting.</p>
          </noscript>
        </div>
      </aside>

      <div class:list={['page', hasBanner && 'page--with-banner']}>
        <slot name="banner" />
        <main
          id="main-content"
          class="content"
          transition:animate="none"
          data-pagefind-body={searchable ? '' : undefined}
          data-pagefind-ignore={searchable ? undefined : 'all'}
        >
          <slot />
        </main>
      </div>
    </div>

    <Footer transition:animate="none" />

    <!-- Theme switch: one button cycling System, Light, Dark.
         The button starts hidden and is shown by this script, so nothing
         renders when JavaScript is off (spec 0004, AC-4).
         The binding runs again on astro:page-load and the saved choice is
         reapplied on astro:after-swap, so both survive client navigation. -->
    <script is:inline>
      ;(function () {
        const order = ['system', 'light', 'dark']
        function label(mode) {
          return 'Theme: ' + mode.charAt(0).toUpperCase() + mode.slice(1)
        }
        function current() {
          try {
            const saved = localStorage.getItem('ucoy-theme')
            if (saved === 'light' || saved === 'dark') return saved
          } catch {
            /* keep system */
          }
          return 'system'
        }
        function apply(mode, button) {
          try {
            if (mode === 'system') {
              document.documentElement.removeAttribute('data-theme')
              localStorage.removeItem('ucoy-theme')
            } else {
              document.documentElement.setAttribute('data-theme', mode)
              localStorage.setItem('ucoy-theme', mode)
            }
          } catch {
            if (mode !== 'system') document.documentElement.setAttribute('data-theme', mode)
          }
          if (button) button.textContent = label(mode)
        }
        // Spec 0008: the swap rebuilds the document root and no built page
        // carries data-theme, so the saved choice is written back after
        // every swap. Idempotent: running it twice changes nothing.
        function reapplyTheme() {
          apply(current(), document.getElementById('theme-button'))
        }
        function initThemeButton() {
          const button = document.getElementById('theme-button')
          if (!button) return
          button.hidden = false
          // A swapped-in page re-runs this script, so the same button would
          // collect two click handlers and skip a mode per press. The flag
          // keeps one handler per element; a swapped-in button is a fresh
          // element and binds normally.
          apply(current(), button)
          if (button.dataset.themeBound) return
          button.dataset.themeBound = 'true'
          button.addEventListener('click', function () {
            const next = order[(order.indexOf(current()) + 1) % order.length]
            apply(next, button)
          })
        }
        initThemeButton()
        // The router dispatches these on document after every swap. The
        // window flag stops this script collecting a duplicate pair each
        // time a swapped-in page re-runs it; window outlives the swap.
        if (!window.__ucoyThemeRouterWired) {
          document.addEventListener('astro:after-swap', reapplyTheme)
          document.addEventListener('astro:page-load', initThemeButton)
          window.__ucoyThemeRouterWired = true
        }
      })()
    </script>
    <!-- Menu toggle: the labels drive a hidden checkbox. A label's click
         normally activates the checkbox and, in some browsers, moves focus to
         it — scrolling the checkbox (at the top of the page) into view and
         yanking the reader back to the top on every open or close. Cancel the
         default action and flip the checked state by hand so focus, and the
         scroll position, stay put. Re-wire on every page load: a swapped-in
         page brings fresh labels, and the data flag keeps one handler per
         label. -->
    <script is:inline>
      ;(function () {
        const FOR = 'sidebar-toggle'
        function bind(label) {
          if (label.dataset.menuBound) return
          label.dataset.menuBound = 'true'
          label.addEventListener('click', function (event) {
            event.preventDefault()
            const toggle = document.getElementById(FOR)
            if (toggle) {
              toggle.checked = !toggle.checked
              // Lock the page scroll while the menu is open so the backdrop
              // and panel stay put and the reader doesn't scroll the content
              // behind them. The attribute mirrors `data-theme`, already set
              // on html by the theme switch.
              document.documentElement.toggleAttribute('data-menu-open', toggle.checked)
            }
          })
        }
        function init() {
          document.querySelectorAll('label[for="' + FOR + '"]').forEach(bind)
          // Browsers restore form control state on a full reload, so a menu
          // left open comes back open. Always start closed. `autocomplete="off"`
          // on the toggle covers pages without JavaScript; this script covers
          // the rest (spec 0004, AC-5).
          const toggle = document.getElementById(FOR)
          if (toggle) toggle.checked = false
        }
        init()
        if (!window.__ucoyMenuRouterWired) {
          document.addEventListener('astro:page-load', init)
          window.__ucoyMenuRouterWired = true
        }
        // Re-assert once the page settles: form state restoration can land
        // after this script runs, so make sure the menu is closed after load.
        // `window` outlives ClientRouter swaps, so the flag keeps a single
        // listener for the lifetime of the tab.
        if (!window.__ucoyMenuLoadWired) {
          window.addEventListener('load', function () {
            const toggle = document.getElementById(FOR)
            if (toggle) toggle.checked = false
          })
          window.__ucoyMenuLoadWired = true
        }
      })()
    </script>
    <!-- Cloudflare Web Analytics (cookieless, AC-3).
         Only loaded when a token is provided. -->
    {SITE_CONFIG.cfAnalyticsToken ? (
      <script type="module">
        const CF_TOKEN = `${SITE_CONFIG.cfAnalyticsToken}`
        const script = document.createElement('script')
        script.src = 'https://static.cloudflareinsights.com/beacon.min.js'
        script.setAttribute('data-cf-beacon', JSON.stringify({ token: CF_TOKEN }))
        script.defer = true
        document.head.appendChild(script)
      </script>
    ) : null}

    <!-- Register the service worker for offline support (AC-7).
         Only register in production: the precache manifest is written by the
         build integration and does not exist in dev, so an active worker there
         would intercept navigation and serve the offline fallback. -->
    <script type="module">
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.debug('SW registration failed:', err)
          })
        })
      }
    </script>
    <script is:inline>
      ;(function () {
        if (window.__ucoySearchShortcutBound) return
        window.__ucoySearchShortcutBound = true
        document.addEventListener('keydown', function (event) {
          const target = event.target
          const tag = target && target.tagName
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return
          const isSlash = event.key === '/'
          const isK = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k'
          if (!isSlash && !isK) return
          const inputs = document.querySelectorAll('.search-input')
          let chosen = null
          for (let i = 0; i < inputs.length; i++) {
            if (inputs[i].getClientRects().length > 0) {
              chosen = inputs[i]
              break
            }
          }
          if (!chosen && inputs.length) chosen = inputs[0]
          if (chosen) {
            event.preventDefault()
            chosen.focus()
            if (typeof chosen.select === 'function') chosen.select()
          }
        })
      })()
    </script>
    <script>
      ;(async function () {
        const highlightPath = '/pagefind/pagefind-highlight.js'
        try {
          const dynamicImport = new Function('u', 'return import(u)')
          const mod = await dynamicImport(highlightPath)
          const PagefindHighlight = mod && (mod.default || mod.PagefindHighlight)
          if (PagefindHighlight) {
            new PagefindHighlight({ highlightParam: 'highlight' })
          }
        } catch {
          // Pagefind highlight is only available in production builds.
        }

        const MARK_SELECTOR = 'mark.pagefind-highlight'
        let toolbar: HTMLElement | null = null
        let countLabel: HTMLElement | null = null
        let currentIndex = 0
        let marks: HTMLElement[] = []

        function ensureToolbar() {
          if (toolbar) return toolbar
          toolbar = document.createElement('div')
          toolbar.id = 'pagefind-highlight-nav'
          toolbar.className = 'highlight-nav'
          toolbar.setAttribute('role', 'toolbar')
          toolbar.setAttribute('aria-label', 'Search match navigation')

          const prevButton = document.createElement('button')
          prevButton.type = 'button'
          prevButton.className = 'highlight-nav-button'
          prevButton.setAttribute('aria-label', 'Previous match')
          prevButton.textContent = '‹'

          countLabel = document.createElement('span')
          countLabel.className = 'highlight-nav-count'
          countLabel.setAttribute('aria-live', 'polite')

          const nextButton = document.createElement('button')
          nextButton.type = 'button'
          nextButton.className = 'highlight-nav-button'
          nextButton.setAttribute('aria-label', 'Next match')
          nextButton.textContent = '›'

          const closeButton = document.createElement('button')
          closeButton.type = 'button'
          closeButton.className = 'highlight-nav-button'
          closeButton.setAttribute('aria-label', 'Close match navigation')
          closeButton.textContent = '×'

          prevButton.addEventListener('click', function () {
            if (!marks.length) return
            currentIndex = (currentIndex - 1 + marks.length) % marks.length
            updateCurrent()
          })
          nextButton.addEventListener('click', function () {
            if (!marks.length) return
            currentIndex = (currentIndex + 1) % marks.length
            updateCurrent()
          })
          closeButton.addEventListener('click', function () {
            if (toolbar) toolbar.style.display = 'none'
            marks.forEach(function (mark) {
              mark.classList.remove('pagefind-highlight--current')
            })
          })

          toolbar.append(prevButton, countLabel, nextButton, closeButton)
          document.body.append(toolbar)
          return toolbar
        }

        function updateCurrent() {
          marks.forEach(function (mark, index) {
            if (index === currentIndex) {
              mark.classList.add('pagefind-highlight--current')
              mark.scrollIntoView({ block: 'center', behavior: 'smooth' })
            } else {
              mark.classList.remove('pagefind-highlight--current')
            }
          })
          if (countLabel)
            countLabel.textContent = marks.length ? currentIndex + 1 + ' / ' + marks.length : ''
        }

        function refresh() {
          marks = Array.from(document.querySelectorAll(MARK_SELECTOR)) as HTMLElement[]
          if (!marks.length) {
            if (toolbar) toolbar.style.display = 'none'
            return
          }
          ensureToolbar()
          if (toolbar) toolbar.style.display = 'flex'
          if (currentIndex >= marks.length) currentIndex = 0
          updateCurrent()
        }

        let refreshTimer: ReturnType<typeof setTimeout> | null = null
        function scheduleRefresh() {
          if (refreshTimer) clearTimeout(refreshTimer)
          refreshTimer = setTimeout(refresh, 120)
        }

        const observer = new MutationObserver(scheduleRefresh)
        observer.observe(document.body, { childList: true, subtree: true })

        setTimeout(refresh, 150)
        setTimeout(refresh, 600)
        setTimeout(refresh, 1500)
      })()
    </script>
  </body>
  <script is:inline>
    ;(function () {
      if (window.__ucoySearchLiveBound) return
      window.__ucoySearchLiveBound = true
      let liveTimer = null
      document.addEventListener('input', function (event) {
        const target = event.target
        if (!target || !target.classList || !target.classList.contains('search-input')) return
        if (location.pathname === '/search' || location.pathname === '/search/') return
        if (liveTimer) clearTimeout(liveTimer)
        liveTimer = setTimeout(function () {
          const query = (target.value || '').trim()
          if (query) window.location.assign('/search?q=' + encodeURIComponent(query))
        }, 300)
      })
    })()
  </script>
</html>

<style>
  body {
    font-family: var(--font-sans);
  }

  .sidebar-toggle {
    position: absolute;
    width: var(--focus-width);
    height: var(--focus-width);
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .sidebar-toggle:focus-visible {
    width: var(--touch-target);
    height: var(--touch-target);
    clip: auto;
    white-space: normal;
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  /* The dim layer fades on the same timing as the panel, so the two move
     together instead of the wash appearing in one step. */
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: var(--scrim);
    z-index: 30;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--motion-duration) ease,
      visibility var(--motion-duration) ease;
  }

  .sidebar-toggle:checked ~ .shell .sidebar-backdrop {
    opacity: 1;
    visibility: visible;
  }

  /* With the menu open, stop the page behind the panel from scrolling so the
     backdrop and panel stay fixed while the sidebar itself still scrolls
     (it has overflow-y: auto). The scrollbar disappearing can nudge content
     by a few pixels, which is acceptable for a narrow-screen menu. */
  html[data-menu-open] {
    overflow: hidden;
  }

  .shell {
    display: block;
  }

  /* The panel is chrome, not content: tapping or dragging on it should
     not pick up its labels by accident. Content stays selectable.
     It rests off the left edge and slides in when the menu checkbox is
     checked. Staying rendered, rather than display none, is what lets the
     move animate, and visibility hidden keeps it out of the tab order and
     away from a screen reader while it is off screen. */
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-width);
    /* Anchor to both viewport edges instead of a fixed height: on Firefox
                                 mobile the search bar retracts when the page scrolls up and the
                                 visual viewport grows, but `100dvh` can stay stuck at the smaller
                                 size and leave a gap below the panel. Stretching between top and
                                 bottom keeps the sidebar flush to the screen at every scroll
                                 position, and overflow-y: auto still scrolls the panel contents. */
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 60;
    border-right: var(--border-width) solid var(--color-sidebar-bg);
    background: var(--color-sidebar-bg);
    color: var(--color-sidebar-text);
    padding: var(--space-m);
    -webkit-user-select: none;
    user-select: none;
    scrollbar-width: thin;
    scrollbar-color: var(--color-sidebar-scroll) var(--color-sidebar-bg);
    transform: translateX(-100%);
    visibility: hidden;
    transition:
      transform var(--motion-duration) ease,
      visibility var(--motion-duration) ease;
  }

  .sidebar-toggle:checked ~ .shell .sidebar {
    transform: translateX(0);
    visibility: visible;
  }

  /* Slim themed scrollbar for the sidebar (Firefox + WebKit).
     Thumb is the sidebar scroll token on a black track, like the old site.
     Widths come from shape tokens so the literal scan stays clean. */
  .sidebar::-webkit-scrollbar {
    width: var(--border-width-heavy);
  }

  .sidebar::-webkit-scrollbar-track {
    background: var(--color-sidebar-bg);
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--color-sidebar-scroll);
    border-radius: var(--radius);
  }

  .sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--color-sidebar-muted);
  }
  /* Pages with a banner: the shell padding and gap frame the content,
     not the banner, so the photo reaches the shell edge with no gap.
     .content keeps its own padding, so only the banner spans edge to
     edge. The child combinator matches the slotted banner, and :global
     is needed because Astro scopes the banner class. */
  .shell--with-banner {
    padding: 0;
    gap: 0;
  }

  .shell--with-banner .content {
    padding: 0 var(--space-s);
  }

  /* No frame around a slotted banner: the photo reaches the shell edge
     and the content below keeps its own top gap. */
  .page--with-banner {
    padding-left: 0;
    padding-right: 0;
  }

  /* With a banner the shell carries no side padding: the banner must
       reach the edges of the content area with no frame around it.
       The text below keeps its own spacing from .content. */
  padding-left: 0;
  padding-right: 0;
  .page--with-banner > :global(.banner) {
    margin-left: 0;
    margin-right: 0;
  }

  /* Below the tablet width there is no sidebar offset, so the page
     spans the viewport and the banner is already flush. */
  .page {
    min-width: 0;
    /* No top padding: a banner page sits flush under the sticky header. */
    padding-top: 0;
  }

  /* With a banner the column padding moves to .content, so the banner
     photo touches the shell on all sides with no gap. The rule below
     the banner still keeps its padding value. */
  .page--with-banner {
    padding: 0;
  }

  .page--with-banner .content {
    padding: var(--space-l) var(--space-s);
  }

  /* The banner floats above .content with no gap of its own, so the
     content top margin below is the only space between them. Slotted
     banners land as a direct child of .page, hence the child combinator.
     Astro scopes the banner class (banner.astro-XXXX), so :global()
     is needed here for the match to fire. */
  .page > :global(.banner) {
    margin: 0;
  }

  .content {
    min-width: 0;
    width: min(100% - var(--space-l), var(--max-content-width));
    margin: var(--space-l) auto var(--space-l);
    padding: 0 var(--space-s);
  }

  .theme-switch {
    padding-top: var(--space-s);
    border-top: var(--border-width) solid var(--color-sidebar-hover);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .theme-button {
    min-height: var(--touch-target);
    border: var(--border-width) solid var(--color-sidebar-hover);
    border-radius: var(--radius);
    background: var(--color-sidebar-hover);
    color: var(--color-sidebar-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    padding: var(--space-2xs) var(--space-s);
  }

  .theme-button:focus-visible {
    outline: var(--focus-width) solid var(--color-sidebar-marker);
    outline-offset: var(--focus-offset);
  }

  .theme-note {
    font-size: var(--text-small);
    color: var(--color-sidebar-muted);
    margin: 0;
  }

  @media (min-width: 48em) {
    .shell {
      display: block;
      padding-inline-start: var(--sidebar-width);
    }

    /* The panel is part of the page at this width: it never slides, and the dim layer is hidden. */
    .sidebar {
      transform: none;
      visibility: visible;
      inset: 0 auto 0 0;
      /* Stretch to the viewport height like the narrow screen panel: a fixed
                                                             height can fall short of the visual viewport when Firefox retracts
                                                             its search bar on scroll up. */
      padding: var(--space-m);
    }

    .sidebar-backdrop {
      display: none;
    }

    .page {
      min-width: 0;
      /* The header is hidden here, so the page reaches the top edge and the banner sits flush. */
      padding-top: 0;
    }

    .page--with-banner {
      padding: 0;
    }

    .page--with-banner .content {
      padding: var(--space-l) var(--space-2xs);
    }

    .content {
      min-width: 0;
      width: min(100% - var(--space-m), var(--max-content-width));
      margin-inline: auto;
      padding: var(--space-l) var(--space-2xs);
    }

    /* The footer sits outside .shell, so it needs the left offset too. */
    :global(.site-footer) {
      margin-inline-start: var(--sidebar-width);
    }
  }

  @media print {
    /* A slotted banner already spans the page, so keep the no-frame padding and drop the offset. */
    .page--with-banner {
      padding-top: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .sidebar,
    .sidebar-backdrop,
    .sidebar-toggle,
    :global(.menu-button),
    :global(.site-footer),
    :global(.skip-link) {
      display: none !important;
    }

    :global(.site-footer) {
      margin-inline-start: 0;
    }

    .shell {
      display: block;
      padding-inline-start: 0;
    }

    .page {
      padding-top: 0;
    }

    .content {
      width: 100%;
      padding: 0;
    }
  }
  .pagefind-highlight {
    background: var(--color-tint);
    color: var(--color-text);
    border-radius: var(--radius);
  }

  .pagefind-highlight--current {
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 0 var(--focus-width) var(--color-focus);
  }

  .highlight-nav {
    position: fixed;
    bottom: var(--space-m);
    right: var(--space-m);
    display: none;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 var(--space-3xs) var(--space-s) var(--color-border);
    z-index: 60;
  }

  .highlight-nav-button {
    min-height: var(--touch-target);
    min-width: var(--touch-target);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-canvas);
    color: var(--color-text);
    cursor: pointer;
    font-size: var(--text-body);
  }

  .highlight-nav-button:focus-visible {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--focus-offset);
  }

  .highlight-nav-count {
    font-size: var(--text-small);
    color: var(--color-text-muted);
    min-width: var(--space-xl);
    text-align: center;
  }
</style>
