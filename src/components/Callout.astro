---
/**
 * Callout block (spec 0004, AC-7).
 * Quiet tinted note for an aside. Meaning never rests on colour alone:
 * an optional title names the note, and the block keeps its border.
 */
interface Props {
  title?: string
}

const { title } = Astro.props
---

<aside class="callout">
  {title && <p class="callout-title">{title}</p>}
  <slot />
</aside>

<style>
  .callout {
    border: var(--border-width) solid var(--color-border);
    border-inline-start: var(--border-width-heavy) solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-tint);
    color: var(--color-text);
    padding: var(--space-s);
    margin: 0 0 var(--space-s) 0;
  }

  .callout-title {
    font-weight: 700;
    margin: 0 0 var(--space-3xs) 0;
    color: var(--color-text);
  }
</style>
