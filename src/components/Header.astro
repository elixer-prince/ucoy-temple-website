---
/**
 * Site header (spec 0004, AC-5).
 * Brand link plus the menu button on a narrow screen.
 *
 * The brand carries two labels, the full temple name and its initials, and
 * CSS shows one of them by width. Both are in the markup so nothing runs
 * and the header works with JavaScript off.
 */
import { SITE_CONFIG } from '@/config/site'
import SearchBox from '@components/SearchBox.astro'

interface Props {
  label?: string
}

const { label = 'Menu' } = Astro.props
const isSearchPage = Astro.url.pathname.replace(/\/$/, '') === '/search'
---

<header class="site-header">
  <div class="header-inner">
    <!-- The accessible name holds the full name and the initials, so a
         voice control user saying the text on screen still matches it
         (WCAG 2.5.3, Label in Name) at either width. -->
    <a href="/" class="logo" aria-label={`${SITE_CONFIG.title} (${SITE_CONFIG.shortTitle})`}>
      <img class="logo-mark" src="/favicon.png" alt="" width="32" height="32" aria-hidden="true" />
      <span class="logo-text">{SITE_CONFIG.title}</span>
      <span class="logo-short">{SITE_CONFIG.shortTitle}</span>
    </a>
    {!isSearchPage && <SearchBox />}
    <label class="menu-button" for="sidebar-toggle">
      {label}
    </label>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-sidebar-bg);
    border-bottom: var(--border-width) solid var(--color-sidebar-hover);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-height: var(--touch-target);
    padding: var(--space-s) var(--space-m);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-lead);
    color: var(--color-sidebar-text);
    text-decoration: none;
  }

  /* The mark is not square (233 by 208), so contain holds its true shape
     inside the square box, and flex none stops the row from squeezing it
     when the brand text is long. */
  .logo-mark {
    flex: none;
    object-fit: contain;
  }

  .logo-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The initials stand in for the full name on narrow screens, where the
     full name and the mark together leave the menu button no room (the
     "Menu" button gets pushed off the right edge just above 375px). Both
     labels are in the markup and CSS picks one by width, so nothing runs
     here. 30em is 480 pixels: every phone in portrait width shows the
     short mark, which always fits, and the full name returns from tablet
     width up where there is ample room. */
  .logo-short {
    display: none;
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 30em) {
    .logo-text {
      display: none;
    }

    .logo-short {
      display: inline;
    }
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-width) solid var(--color-sidebar-hover);
    border-radius: var(--radius);
    background: var(--color-sidebar-hover);
    color: var(--color-sidebar-text);
    font-weight: 600;
    cursor: pointer;
  }

  .menu-button:focus-visible {
    outline: var(--focus-width) solid var(--color-sidebar-marker);
    outline-offset: var(--focus-offset);
  }

  @media (min-width: 48em) {
    .site-header {
      display: none;
    }
  }
</style>
