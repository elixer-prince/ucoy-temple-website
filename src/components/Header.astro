---
import { SITE_CONFIG } from '@/config/site'

interface Props {
  /** Override the label text — defaults to "Menu" (visually only on mobile). */
  label?: string
}

const { label = 'Menu' } = Astro.props

// Navigation order matches the `order` field in content/pages frontmatter,
// plus the standalone contact page.
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/history', label: 'History' },
  { href: '/visiting', label: 'Visiting' },
  { href: '/contact', label: 'Contact' }
]
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={SITE_CONFIG.title}>
      <img src="/favicon.svg" alt="" width="32" height="32" aria-hidden="true" />
      <span class="logo-text">{SITE_CONFIG.title}</span>
    </a>

    <!-- CSS-only, no-JS menu toggle — keyboard accessible (AC-5). -->

    <!-- CSS-only, no-JS menu toggle — keyboard accessible (AC-5). -->
    <details class="nav-details" role="group" aria-label="Main navigation">
      <summary class="nav-toggle" aria-label={label}>
        <span class="nav-toggle-text">{label}</span>
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </summary>
      <nav class="nav" aria-label="Main">
        <ul class="nav-list">
          {navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: var(--border-width) solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.75rem 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
  }

  .logo-text {
    white-space: nowrap;
  }

  .nav-details {
    line-height: 1;
  }

  .nav-toggle {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggle::-webkit-details-marker {
    display: none;
  }

  .nav-toggle:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .nav-toggle-icon {
    display: inline-block;
    width: 1.25rem;
    height: 2px;
    background: var(--body);
  }

  .nav {
    margin-top: 1rem;
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  /* Desktop: horizontal nav, hide the toggle */
  @media (min-width: 48em) {
    .nav-details {
      display: contents;
    }

    .nav-toggle {
      display: none;
    }

    .nav {
      margin: 0;
    }

    .nav-list {
      flex-direction: row;
      gap: 1.5rem;
    }
  }
</style>
