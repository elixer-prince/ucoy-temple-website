---
/**
 * Site header (spec 0004, AC-5).
 * Brand link plus the menu button on a narrow screen.
 */
import { SITE_CONFIG } from '@/config/site'

interface Props {
  label?: string
}

const { label = 'Menu' } = Astro.props
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label={SITE_CONFIG.title}>
      <img class="logo-mark" src="/favicon.png" alt="" width="32" height="32" aria-hidden="true" />
      <span class="logo-text">{SITE_CONFIG.title}</span>
    </a>
    <label class="menu-button" for="sidebar-toggle">
      {label}
    </label>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-sidebar-bg);
    border-bottom: var(--border-width) solid var(--color-sidebar-hover);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    min-height: var(--touch-target);
    padding: var(--space-s) var(--space-m);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-lead);
    color: var(--color-sidebar-text);
    text-decoration: none;
  }

  /* The mark is not square (233 by 208), so contain holds its true shape
     inside the square box, and flex none stops the row from squeezing it
     when the brand text is long. */
  .logo-mark {
    flex: none;
    object-fit: contain;
  }

  .logo-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: var(--space-2xs) var(--space-s);
    border: var(--border-width) solid var(--color-sidebar-hover);
    border-radius: var(--radius-sm);
    background: var(--color-sidebar-hover);
    color: var(--color-sidebar-text);
    font-weight: 600;
    cursor: pointer;
  }

  .menu-button:focus-visible {
    outline: var(--focus-width) solid var(--color-sidebar-marker);
    outline-offset: var(--focus-offset);
  }

  @media (min-width: 48em) {
    .site-header {
      display: none;
    }
  }
</style>
