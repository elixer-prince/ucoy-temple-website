---
/**
 * Site footer (spec 0004).
 * Temple name, contact address, copyright, analytics line,
 * and the line about the theme choice kept on the device.
 */
import { SITE_CONFIG } from '@/config/site'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-title">{SITE_CONFIG.title}</span>

    {compact ? (
      <p class="footer-small">
        © {new Date().getFullYear()} {SITE_CONFIG.author}
      </p>
    ) : (
      <>
        <p class="footer-contact">
          Contact: <a href={`mailto:${SITE_CONFIG.contactEmail}`}>{SITE_CONFIG.contactEmail}</a>
        </p>

        <p class="footer-small">
          © {new Date().getFullYear()} {SITE_CONFIG.author}
        </p>

        <p class="footer-small">
          This site uses{' '}
          <a href="https://developers.cloudflare.com/web-analytics/">Cloudflare Web Analytics</a>{' '}
          (cookieless) and is served as static HTML with no cookies or tracking beyond that.
        </p>

        <p class="footer-small">
          The display theme choice (light or dark) is kept on your own device only.
        </p>
      </>
    )}
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    margin-top: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-l) var(--space-s);
  }

  .footer-title {
    font-family: var(--font-serif);
    font-size: var(--text-lead);
    font-weight: 700;
    color: var(--color-text);
  }

  .footer-contact {
    margin: 0;
    color: var(--color-text);
  }

  .footer-small {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-small);
    line-height: var(--body-line-height);
  }
</style>
