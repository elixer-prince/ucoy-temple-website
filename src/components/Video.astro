---
/**
 * The site's own video player, used inline inside service bodies (spec 0003).
 *
 * Service bodies are MDX and call this component as `<Video src="…" />`. The
 * route that renders the body passes this component in, so no content file
 * repeats an import (spec 0003, Page body rules).
 *
 * The file is served from this site, never from a third party, and the player
 * is plain HTML with the browser's native controls, so it needs no client side
 * framework and no JavaScript of ours.
 */
interface Props {
  /** The video file, a path under public/videos/ such as /videos/opening.mp4. */
  src: string
  /** Optional caption shown under the player. */
  caption?: string
  /** Optional still image shown before the video loads, under public/videos/. */
  poster?: string
}

const { src, caption, poster } = Astro.props
---

<figure class="video">
  <!-- preload="metadata" keeps a phone from pulling a whole video over a slow
       connection just to show the page; the poster covers the wait. -->
  <video
    class="video-player"
    controls
    playsinline
    preload="metadata"
    src={src}
    poster={poster}
    data-video-src={src}
  >
    <p>
      Your browser cannot play this video. <a href={src}>Download it instead</a>.
    </p>
  </video>

  {caption && <figcaption class="video-caption">{caption}</figcaption>}
</figure>

<!-- PostHog video tracking (spec 0010, AC-2).
     Fires a custom event when the video starts playing and when it ends.
     Only runs when PostHog is initialized (production, API key present). -->
<script is:inline>
  ;(function () {
    const video = document.currentScript
      ? document.currentScript.parentElement?.querySelector('video[data-video-src]')
      : null
    if (!video) return
    const videoSrc = video.dataset.videoSrc
    let played = false
    video.addEventListener('play', function () {
      if (played) return
      played = true
      try {
        const ph = window.posthog
        if (ph) {
          ph.capture('Video Played', { video: videoSrc, event: 'start' })
        }
      } catch {
        /* analytics non-critical */
      }
    })
    video.addEventListener('ended', function () {
      try {
        const ph = window.posthog
        if (ph) {
          ph.capture('Video Played', { video: videoSrc, event: 'complete' })
        }
      } catch {
        /* analytics non-critical */
      }
    })
  })()
</script>

<style>
  .video {
    margin: 0 0 var(--space-m) 0;
  }

  .video-player {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    background: var(--color-text);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
  }

  .video-caption {
    margin-top: var(--space-3xs);
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
</style>
