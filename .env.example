# Copy this file to .env and fill in the values supplied by the temple.
# These are public client-side variables (bundled into the HTML), so they
# must not contain secrets.  Set the real values in the Cloudflare Pages
# dashboard under Settings → Environment Variables → Production.

# The temple's email address, shown on the contact page and in the
# privacy notice.
CONTACT_EMAIL=contact@ucoy.org

# The Formspree form action URL that receives contact-form submissions.
# Create a form at https://formspree.io and paste the endpoint here, e.g.
# https://formspree.io/f/xvodyjln
FORM_ENDPOINT=https://formspree.io/f/placeholder

# The Google Calendar embed ID (the calendar's public ID, usually ending
# in @group.calendar.google.com).
CALENDAR_ID=placeholder

# The temple's local timezone, used by the calendar embed.
CALENDAR_TIMEZONE=America/New_York

# Cloudflare Web Analytics token (the data-cf-beacon token).
# Leave empty if analytics is not yet enabled.
CF_ANALYTICS_TOKEN=
